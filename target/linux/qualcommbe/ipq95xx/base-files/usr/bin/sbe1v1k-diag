#!/bin/sh
# Collect board / partition / wireless / log snippets for Askey SBE1V1K bring-up.

echo '=== release ==='
cat /etc/openwrt_release 2>/dev/null
[ -f /etc/sbe1v1k-release ] && cat /etc/sbe1v1k-release

echo '=== board ==='
ubus call system board 2>/dev/null
cat /tmp/sysinfo/board_name /tmp/sysinfo/model 2>/dev/null

echo '=== kernel ==='
uname -a
cat /proc/cmdline

echo '=== partitions ==='
cat /proc/partitions
blkid 2>/dev/null

echo '=== network ==='
ip -br link
ip -br addr
ubus call network.interface dump 2>/dev/null

echo '=== wireless ==='
iw dev 2>/dev/null
iw phy 2>/dev/null
uci -q show wireless 2>/dev/null

echo '=== modules ==='
lsmod

echo '=== recent kernel warnings/errors ==='
dmesg | grep -Ei 'error|fail|warn|ath12k|qcom_ppe|rtl826|qca80|mmc|f2fs' | tail -n 400

echo '=== recent system log ==='
logread | tail -n 400
