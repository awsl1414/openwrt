#!/bin/sh
# askey,sbe1v1k: ath12k WSI phy appears after netifd. Stock 10-wifi-detect
# only retries existing radios; 11-ath12k-trigger needs UCI path= (we use phy=wl0).
# Background wifi up once so hotplug-call is not blocked.

[ "${ACTION}" = "add" ] || exit 0

. /lib/functions.sh

case "$(board_name)" in
askey,sbe1v1k) ;;
*) exit 0 ;;
esac

[ -n "$DEVICENAME" ] || exit 0
[ -d "/sys/class/ieee80211/${DEVICENAME}" ] || exit 0
[ -n "$DEVPATH" ] && [ -f "/sys/$DEVPATH/device/uevent" ] || exit 0
grep -q 'DRIVER=ath12k_pci' "/sys/$DEVPATH/device/uevent" || exit 0
[ -f /tmp/.askey-sbe1v1k-wifi-up ] && exit 0

touch /tmp/.askey-sbe1v1k-wifi-up

(
	n=0
	while [ "$n" -lt 30 ]; do
		ubus -S list network.wireless >/dev/null 2>&1 && break
		sleep 1
		n=$((n + 1))
	done
	if ! ubus -S list network.wireless >/dev/null 2>&1; then
		logger -t askey-sbe1v1k-wifi "network.wireless not ready; skip wifi up"
		rm -f /tmp/.askey-sbe1v1k-wifi-up
		exit 0
	fi

	# 10-wifi-detect already ran wifi config; only re-config if status still empty.
	status="$(ubus -S call network.wireless status 2>/dev/null)"
	case "$status" in
	""|"{}") /sbin/wifi config ;;
	esac

	try=0
	while [ "$try" -lt 3 ]; do
		/sbin/wifi up && exit 0
		sleep 5
		try=$((try + 1))
	done
	logger -t askey-sbe1v1k-wifi "wifi up failed after retries"
	rm -f /tmp/.askey-sbe1v1k-wifi-up
) &

exit 0
