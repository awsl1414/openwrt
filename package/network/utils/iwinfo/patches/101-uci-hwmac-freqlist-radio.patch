+static int nl80211_freqlist_want_radio(const char *ifname)
+{
+	struct nl80211_if_data data = {};
+	int radio_idx = -1;
+
+	if (!ifname)
+		return -1;
+
+	/* Netdev: use VIF radio mask when present. */
+	if (nl80211_is_ifname(ifname)) {
+		if (!nl80211_get_if_data(ifname, &data) && data.radio_idx >= 0)
+			return data.radio_idx;
+		return -1;
+	}
+
+	/* Bare phy name → whole wiphy. */
+	if (nl80211_phy_idx_from_phy(ifname) >= 0)
+		return -1;
+
+	/* UCI wifi-device section: hwmac line index / option radio. */
+	if (nl80211_phy_idx_from_uci_ex(ifname, &radio_idx) >= 0)
+		return radio_idx;
+
+	return -1;
+}
