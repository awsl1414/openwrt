+#define NL80211_FREQLIST_MAX_RANGES 8
+
+struct nl80211_freqlist_ctx {
+	struct iwinfo_freqlist_entry *tmp;
+	int tmp_max;
+	int count;
+	int want_radio;
+	int have_ranges;
+	uint32_t range_start[NL80211_FREQLIST_MAX_RANGES];
+	uint32_t range_end[NL80211_FREQLIST_MAX_RANGES];
+	int n_ranges;
+};
+
+static bool nl80211_mhz_in_radio_ranges(struct nl80211_freqlist_ctx *ctx, uint32_t mhz)
+{
+	uint32_t khz = mhz * 1000;
+	int i;
+
+	if (!ctx->have_ranges || ctx->n_ranges <= 0)
+		return true;
+
+	for (i = 0; i < ctx->n_ranges; i++) {
+		if (khz >= ctx->range_start[i] && khz <= ctx->range_end[i])
+			return true;
+	}
+
+	return false;
+}
+
+static void nl80211_freqlist_parse_radios(struct nlattr *radios,
+					 struct nl80211_freqlist_ctx *ctx)
+{
+	struct nlattr *radio;
+	int rem;
+
+	if (ctx->want_radio < 0 || !radios)
+		return;
+
+	nla_for_each_nested(radio, radios, rem) {
+		struct nlattr *prop;
+		int prem, idx = -1, ranges = 0;
+		uint32_t start[NL80211_FREQLIST_MAX_RANGES];
+		uint32_t end[NL80211_FREQLIST_MAX_RANGES];
+
+		/*
+		 * Same layout as iw info.c: each radio nest has sibling attrs;
+		 * FREQ_RANGE may appear multiple times (not one nested list).
+		 */
+		nla_for_each_nested(prop, radio, prem) {
+			struct nlattr *fr[NL80211_WIPHY_RADIO_FREQ_ATTR_MAX + 1];
+
+			switch (nla_type(prop)) {
+			case NL80211_WIPHY_RADIO_ATTR_INDEX:
+				idx = nla_get_u32(prop);
+				break;
+			case NL80211_WIPHY_RADIO_ATTR_FREQ_RANGE:
+				if (ranges >= NL80211_FREQLIST_MAX_RANGES)
+					break;
+				if (nla_parse_nested(fr, NL80211_WIPHY_RADIO_FREQ_ATTR_MAX,
+						    prop, NULL))
+					break;
+				if (!fr[NL80211_WIPHY_RADIO_FREQ_ATTR_START] ||
+				    !fr[NL80211_WIPHY_RADIO_FREQ_ATTR_END])
+					break;
+				start[ranges] = nla_get_u32(fr[NL80211_WIPHY_RADIO_FREQ_ATTR_START]);
+				end[ranges] = nla_get_u32(fr[NL80211_WIPHY_RADIO_FREQ_ATTR_END]);
+				ranges++;
+				break;
+			}
+		}
+
+		if (idx != ctx->want_radio || ranges <= 0)
+			continue;
+
+		ctx->n_ranges = ranges;
+		memcpy(ctx->range_start, start, ranges * sizeof(start[0]));
+		memcpy(ctx->range_end, end, ranges * sizeof(end[0]));
+		ctx->have_ranges = 1;
+		break;
+	}
+}
