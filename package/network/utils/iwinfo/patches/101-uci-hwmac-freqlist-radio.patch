+/* Match radio-mac.uc normalize_mac: only hex MACs occupy radio indices. */
+static bool nl80211_is_hwmac(const char *mac)
+{
+	int i;
+
+	if (!mac)
+		return false;
+
+	for (i = 0; i < 17; i++) {
+		char c = mac[i];
+
+		if ((i % 3) == 2) {
+			if (c != ':')
+				return false;
+		} else if (!((c >= '0' && c <= '9') ||
+			     (c >= 'a' && c <= 'f') ||
+			     (c >= 'A' && c <= 'F'))) {
+			return false;
+		}
+	}
+
+	return mac[17] == '\0';
+}
+
+/*
+ * Permanent per-radio MAC from wifi-device.hwmac (not macaddr/BSSID).
+ * Matches /sys/class/ieee80211/<phy>/addresses line order (== wiphy radio index).
+ */
+static int nl80211_phy_idx_from_hwmac(const char *hwmac, int *radio_idx)
+{
+	char path[128], line[64];
+	glob_t gl;
+	FILE *fp;
+	int i, lineno, phyidx = -1;
+
+	if (radio_idx)
+		*radio_idx = -1;
+
+	if (!nl80211_is_hwmac(hwmac))
+		return -1;
+
+	snprintf(path, sizeof(path), "/sys/class/ieee80211/*");
+	if (glob(path, 0, NULL, &gl))
+		return -1;
+
+	for (i = 0; i < gl.gl_pathc; i++) {
+		snprintf(path, sizeof(path), "%s/addresses", gl.gl_pathv[i]);
+		fp = fopen(path, "r");
+		if (!fp)
+			continue;
+
+		lineno = 0;
+		while (fgets(line, sizeof(line), fp)) {
+			size_t n = strlen(line);
+
+			while (n > 0 && (line[n - 1] == '\n' || line[n - 1] == '\r'))
+				line[--n] = '\0';
+
+			if (!nl80211_is_hwmac(line))
+				continue;
+
+			if (!strcasecmp(hwmac, line)) {
+				snprintf(path, sizeof(path), "%s/index", gl.gl_pathv[i]);
+				phyidx = nl80211_readint(path);
+				if (phyidx >= 0 && radio_idx)
+					*radio_idx = lineno;
+				fclose(fp);
+				globfree(&gl);
+				return phyidx;
+			}
+			lineno++;
+		}
+
+		fclose(fp);
+	}
+
+	globfree(&gl);
+	return -1;
+}
