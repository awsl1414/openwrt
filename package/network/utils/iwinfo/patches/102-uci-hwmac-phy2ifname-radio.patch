+/* Permanent radio MAC for a wifi-device section (UCI hwmac or addresses[]). */
+static int nl80211_uci_want_mac(const char *name, int phyidx, int radio_idx,
+				char *buf, size_t buflen)
+{
+	struct uci_section *s;
+	const char *opt;
+	char *phy, path[128], line[64];
+	FILE *fp;
+	int lineno = 0;
+
+	if (!name || !buf || buflen < 18)
+		return -1;
+
+	buf[0] = '\0';
+
+	s = iwinfo_uci_get_radio(name, "mac80211");
+	if (s) {
+		opt = uci_lookup_option_string(uci_ctx, s, "hwmac");
+		if (opt && nl80211_is_hwmac(opt))
+			snprintf(buf, buflen, "%s", opt);
+		iwinfo_uci_free();
+	}
+
+	if (buf[0])
+		return 0;
+
+	if (phyidx < 0 || radio_idx < 0)
+		return -1;
+
+	phy = nl80211_phyidx2name(phyidx);
+	if (!phy)
+		return -1;
+
+	snprintf(path, sizeof(path), "/sys/class/ieee80211/%s/addresses", phy);
+	fp = fopen(path, "r");
+	if (!fp)
+		return -1;
+
+	while (fgets(line, sizeof(line), fp)) {
+		size_t n = strlen(line);
+
+		while (n > 0 && (line[n - 1] == '\n' || line[n - 1] == '\r'))
+			line[--n] = '\0';
+
+		if (!nl80211_is_hwmac(line))
+			continue;
+
+		if (lineno == radio_idx) {
+			snprintf(buf, buflen, "%s", line);
+			fclose(fp);
+			return 0;
+		}
+		lineno++;
+	}
+
+	fclose(fp);
+	return -1;
+}
+
+static char * nl80211_phy2ifname(const char *ifname)
+{
+	int ifidx = -1, cifidx, lmode = 1, clmode, phyidx, want_radio = -1;
+	char buffer[512];
+	char want_mac[18] = "";
+	static char nif[IFNAMSIZ] = { 0 };
+	DIR *d;
+	struct dirent *e;
+
+	/* Only accept phy name in the form of phy%d or radio%d */
+	if (!ifname)
+		return NULL;
+
+	phyidx = nl80211_phy_idx_from_phy(ifname);
+	if (phyidx < 0)
+		phyidx = nl80211_phy_idx_from_uci_ex(ifname, &want_radio);
+	if (phyidx < 0)
+		return NULL;
+
+	/*
+	 * Multi-radio wiphy: UCI section names must map to the netdev for that
+	 * radio (hwmac ↔ interface address), not the lowest ifindex on the phy.
+	 * Otherwise info/bssid/channel for radio1 incorrectly report radio0.
+	 */
+	if (want_radio >= 0)
+		nl80211_uci_want_mac(ifname, phyidx, want_radio,
+				     want_mac, sizeof(want_mac));
+
+	memset(nif, 0, sizeof(nif));
+
+	if ((d = opendir("/sys/class/net")) != NULL)
+	{
+		while ((e = readdir(d)) != NULL)
+		{
+			snprintf(buffer, sizeof(buffer),
+			         "/sys/class/net/%s/phy80211/index", e->d_name);
+			if (nl80211_readint(buffer) != phyidx)
+				continue;
+
+			if (want_mac[0]) {
+				char addr[32];
+
+				snprintf(buffer, sizeof(buffer),
+					 "/sys/class/net/%s/address", e->d_name);
+				if (nl80211_readstr(buffer, addr, sizeof(addr)) <= 0)
+					continue;
+				if (strcasecmp(addr, want_mac))
+					continue;
+			}
+
+			snprintf(buffer, sizeof(buffer),
+			         "/sys/class/net/%s/ifindex", e->d_name);
+			cifidx = nl80211_readint(buffer);
+
+			if (cifidx < 0)
+				continue;
+
+			snprintf(buffer, sizeof(buffer),
+			         "/sys/class/net/%s/link_mode", e->d_name);
+			clmode = nl80211_readint(buffer);
+
+			/* prefer non-supplicant-based devices */
+			if ((ifidx < 0) || (cifidx < ifidx) || ((lmode == 1) && (clmode != 1)))
+			{
+				ifidx = cifidx;
+				lmode = clmode;
+				strncpy(nif, e->d_name, sizeof(nif) - 1);
+			}
+		}
+
+		closedir(d);
+	}
+
+	return nif[0] ? nif : NULL;
+}
