# Minimal bring-up seed for Askey SBE1V1K (qualcommbe / ipq95xx).
# Use when you only need device + Luci SSL to boot/flash:
#   bash scripts/sbe1v1k/build-arch.sh --minimal …
#
# Default daily builds use scripts/sbe1v1k/daily.config instead.

CONFIG_TARGET_qualcommbe=y
CONFIG_TARGET_qualcommbe_ipq95xx=y
CONFIG_TARGET_qualcommbe_ipq95xx_DEVICE_askey_sbe1v1k=y

CONFIG_TARGET_ROOTFS_INITRAMFS=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y

CONFIG_PACKAGE_luci-ssl=y
CONFIG_LUCI_LANG_zh_Hans=y
