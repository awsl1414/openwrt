# Bring-up seed for Askey SBE1V1K (qualcommbe / ipq95xx).
# Used by scripts/sbe1v1k/build-arch.sh → copied to .config → make defconfig.
#
# Device packages come from Device/askey_sbe1v1k; this seed pins the profile,
# luci-ssl, and optional community LuCI themes (not for upstream device commits).
# Pass --skip-themes to build-arch.sh to strip the theme packages below.

CONFIG_TARGET_qualcommbe=y
CONFIG_TARGET_qualcommbe_ipq95xx=y
CONFIG_TARGET_qualcommbe_ipq95xx_DEVICE_askey_sbe1v1k=y

# TFTP first boot
CONFIG_TARGET_ROOTFS_INITRAMFS=y

# eMMC sysupgrade / factory (Device/EmmcImage)
CONFIG_TARGET_ROOTFS_SQUASHFS=y

# Web UI (uhttpd + TLS). Requires luci feed (build-arch.sh feeds install).
CONFIG_PACKAGE_luci-ssl=y

# Community LuCI themes (pinned clones under package/; see build-arch.sh).
# Default LuCI theme remains bootstrap from luci-ssl; switch in LuCI:
# System → System → Language and Style.
CONFIG_PACKAGE_luci-theme-aurora=y
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-theme-alpha=y
# Hard dependency of luci-theme-alpha
CONFIG_PACKAGE_luci-app-alpha-config=y
