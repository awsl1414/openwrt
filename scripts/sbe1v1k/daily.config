# Daily-use seed for Askey SBE1V1K (qualcommbe / ipq95xx).
# Default for scripts/sbe1v1k/build-arch.sh → .config → make defconfig.
#
# Device firmware/wifi packages come from Device/askey_sbe1v1k.
# This seed pins the profile plus a lean daily rootfs (LuCI + tools).
# Community themes are NOT in this seed — pass --themes to build-arch.sh.
# Not a Dedrimer-style product image (no iStore / Docker / samba).
#
# Slim bring-up only: scripts/sbe1v1k/minimal.config
#   bash scripts/sbe1v1k/build-arch.sh --minimal …

CONFIG_TARGET_qualcommbe=y
CONFIG_TARGET_qualcommbe_ipq95xx=y
CONFIG_TARGET_qualcommbe_ipq95xx_DEVICE_askey_sbe1v1k=y

# TFTP first boot
CONFIG_TARGET_ROOTFS_INITRAMFS=y

# eMMC sysupgrade / factory (Device/EmmcImage)
CONFIG_TARGET_ROOTFS_SQUASHFS=y

# --- Web UI ---
# luci-ssl → uhttpd + luci + TLS (bootstrap theme).
CONFIG_PACKAGE_luci-ssl=y
# All selected LuCI packages get luci-i18n-*-zh-cn; zz-askey sets luci.main.lang.
CONFIG_LUCI_LANG_zh_Hans=y

# --- Daily LuCI apps (official feeds) ---
CONFIG_PACKAGE_luci-app-attendedsysupgrade=y
CONFIG_PACKAGE_luci-app-statistics=y
CONFIG_PACKAGE_collectd-mod-cpu=y
CONFIG_PACKAGE_collectd-mod-interface=y
CONFIG_PACKAGE_collectd-mod-iwinfo=y
CONFIG_PACKAGE_collectd-mod-load=y
CONFIG_PACKAGE_collectd-mod-memory=y
CONFIG_PACKAGE_collectd-mod-network=y
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_luci-app-wol=y
CONFIG_PACKAGE_luci-app-banip=y
CONFIG_PACKAGE_luci-app-ttyd=y

# --- Daily CLI / diagnostics (Preview 2 set + light QoL) ---
CONFIG_PACKAGE_ethtool-full=y
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_pciutils=y
CONFIG_PACKAGE_tcpdump-mini=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_nano=y
CONFIG_PACKAGE_openssh-sftp-server=y
CONFIG_PACKAGE_curl=y
